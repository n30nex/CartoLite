RESTIC_REPOSITORY=s3:https://tor1.digitaloceanspaces.com/replace-private-bucket/cartolite
RESTIC_PASSWORD_FILE=/etc/cartolite-restic-password
RESTIC_CACHE_DIR=/var/cache/cartolite-backup
AWS_ACCESS_KEY_ID=replace-with-bucket-restricted-key-id
AWS_SECRET_ACCESS_KEY=replace-with-bucket-restricted-secret
DISCORD_WEBHOOK_URL=replace-with-private-discord-webhook
CARTOLITE_STATE_PATH=/var/lib/docker/volumes/cartolite_cartolite-data/_data/state-v1.json
CARTOLITE_APP_ENV=/opt/CartoLite/.env
CARTOLITE_BACKUP_WORK=/var/lib/cartolite-backup
